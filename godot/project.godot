; Tribology Simulator & Industrial Workshop 2.0 (antes Scratch Tribology Simulator) · Godot 4.7
; Un solo programa con dos secciones: Tribología biológica y Taller industrial.

config_version=5

[application]

config/name="Tribology Simulator & Industrial Workshop"
config/description="Tribología biológica y taller industrial: qué raya, corta o mecaniza a qué, y por qué."
config/version="2.0.0-prototipo"
config/use_custom_user_dir=true
config/custom_user_dir_name="TribologySimulatorWorkshop"
config/project_settings_override="user://graficos.cfg"
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.0901961, 0.054902, 0.109804, 1)
config/icon="res://assets/icon.png"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1240
window/size/viewport_height=880
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[internationalization]

locale/fallback="es"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0901961, 0.054902, 0.109804, 1)
