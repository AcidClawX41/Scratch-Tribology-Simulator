## Significado de un código en un dialecto ("" si no está en la tabla).
static func meaning(dialect: String, code: String) -> String:
	var d: Dictionary = DIALECTS.get(dialect, {})
	var codes: Dictionary = d.get("codes", {})
	var c: Dictionary = codes.get(code, {})
	return str(c.get("meaning", ""))


## Pista para quien viene de Fanuc: qué hace ese código en el 8055 y cómo se programa aquí ("" si no hay choque).
static func fanuc_hint(code: String) -> String:
	var c: Dictionary = DIALECTS["fanucT"]["codes"].get(code, {})
	if c.is_empty():
		return ""
	return "En Fanuc T, %s es «%s». %s." % [code, str(c["meaning"]).split(":")[0], c["fagor"]]
