{
  "expo": {
    "name": "Scratch Tribology Simulator",
    "slug": "scratch-tribology-simulator",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "scratchtribology",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#170E1C",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.acidclawx41.scratchtribology",
      "buildNumber": "2",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSHumanReadableCopyright": "© 2026 Eric Valls Gramunt · MIT License"
      }
    },
    "android": {
      "package": "com.acidclawx41.scratchtribology",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#170E1C"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#170E1C"
        }
      ]
    ]
  }
}
