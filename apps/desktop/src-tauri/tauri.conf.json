{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scratch Tribology Simulator",
  "version": "1.0.0",
  "identifier": "com.acidclawx41.scratchtribology",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scratch Tribology Simulator",
        "width": 1240,
        "height": 880,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#170E1C",
        "preventOverflow": true,
        "zoomHotkeysEnabled": true,
        "scrollBarStyle": "fluentOverlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Banco de tribología: qué raya a qué",
    "longDescription": "Simulador educativo de rayado, punción y abrasión: uñas (también de metal, zafiro o diamante), garras de mamíferos y aves, colmillos de víbora, y la piel humana por capas. Dureza Vickers, presión de contacto, Hertz, Archard, Hokkirigawa-Kato y JKR.",
    "copyright": "© 2026 Eric Valls Gramunt",
    "license": "MIT",
    "publisher": "Eric Valls Gramunt",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "section": "education"
      }
    }
  }
}
